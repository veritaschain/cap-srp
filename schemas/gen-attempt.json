{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veritaschain.org/schemas/cap-srp/v0.1/gen-attempt.json",
  "title": "CAP-SRP GEN_ATTEMPT Event",
  "description": "Generation attempt event - logged BEFORE any safety evaluation begins",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "prompt_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv7 event identifier (time-sortable)"
    },
    "event_type": {
      "const": "GEN_ATTEMPT",
      "description": "Event type discriminator"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp with timezone"
    },
    "chain_id": {
      "type": "string",
      "format": "uuid",
      "description": "Chain identifier for grouping related events"
    },
    "previous_hash": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^sha256:[a-f0-9]{64}$", "minLength": 71, "maxLength": 71 }
      ],
      "description": "Hash of previous event; empty string for genesis, matching CAPEvent.to_dict()"
    },
    "current_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of this event"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9+/]{85}[AQgw]==$",
      "minLength": 96,
      "maxLength": 96,
      "description": "ed25519: followed by canonical padded Base64 encoding of the 64-byte signature; format validation only"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA-256 hash of the user prompt (privacy-preserving)"
    },
    "user_context_hash": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^sha256:[a-f0-9]{64}$", "minLength": 71, "maxLength": 71 }
      ],
      "description": "SHA-256 hash of user context data, or empty string when omitted by the caller"
    },
    "session_id": {
      "type": "string",
      "description": "Session identifier for grouping user interactions"
    },
    "model_id": {
      "type": "string",
      "description": "AI model identifier and version"
    },
    "policy_version": {
      "type": "string",
      "pattern": "^v?\\d+\\.\\d+(\\.\\d+)?$",
      "description": "Safety policy version (semver)"
    }
  },
  "additionalProperties": false
}
